set_global_assignment -name VERILOG_MACRO TARGET=mister
set_global_assignment -name seed 0
set_global_assignment -name SEARCH_PATH rtl/osman
set_global_assignment -name SEARCH_PATH rtl/generated
set_global_assignment -name SEARCH_PATH .
