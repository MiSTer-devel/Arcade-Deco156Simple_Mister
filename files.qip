# Auto-generated base by vendoring/vendor.py — Deco156Simple (osman) MiSTer core file list.
# Edit by hand to add/remove modules; vendor.py only refreshes CONTENT.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/emu.sv
# rtl/crt_adjust.sv: core-side "CRT Adjust" (H-Size / H-Position / V-Shift).
# No sys_top.v edit required (framework off-limits) - inserted in emu.sv on the
# analog video path before arcade_video. See MiSTer-CRT-Adjust for the module.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/crt_adjust.sv
# rtl/analog_hsize.sv is intentionally NOT built: it needs a sys_top.v edit
# (framework off-limits). Superseded by crt_adjust.sv; kept in-tree for reference.

